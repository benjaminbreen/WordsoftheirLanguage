---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props { title?: string; description?: string; nav?: "tables" | "languages" | "search" | "about" | ""; image?: string }
const { title, description = "Vocabularies of the world's languages printed in early modern books, shown as printed beside careful transcriptions.", nav = "", image } = Astro.props;
const full = title ? `${title} · Wordes of their Language` : "Wordes of their Language";
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = image ? new URL(image, Astro.site).href : undefined;
const links = [
  ["tables", "/", "Tables"],
  ["languages", "/languages", "Languages"],
  ["search", "/search", "Search"],
  ["about", "/about", "About"],
] as const;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  {og && <meta property="og:image" content={og} />}
  <meta name="twitter:card" content={og ? "summary_large_image" : "summary"} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta name="theme-color" content="#f6f6f3" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#121416" media="(prefers-color-scheme: dark)" />
  <script is:inline>
    try { const t = localStorage.getItem("wotl-theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <slot name="head" />
</head>
<body>
  <a class="sr-only" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      <a class="wordmark" href="/">Wordes of their Language</a>
      <nav class="nav" aria-label="Sections">
        {links.map(([k, href, label]) => <a href={href} aria-current={nav === k ? "page" : undefined}>{label}</a>)}
      </nav>
      <div class="header-tools">
        <form class="searchbox" action="/search" role="search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
          <input id="site-search" name="q" type="search" placeholder="Search a word in every table" aria-label="Search every table" autocomplete="off" />
          <kbd aria-hidden="true">/</kbd>
        </form>
        <a class="icon-btn search-icon" href="/search" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        </a>
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch light or dark theme" title="Light / dark">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>
    <nav class="mobile-nav" aria-label="Sections">
      {links.map(([k, href, label]) => <a href={href} aria-current={nav === k ? "page" : undefined}>{label}</a>)}
    </nav>
  </header>
  <main id="main">
    <slot />
  </main>
  <Footer />
  <script>
    const root = document.documentElement;
    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
      root.dataset.theme = dark ? "light" : "dark";
      try { localStorage.setItem("wotl-theme", root.dataset.theme); } catch (e) {}
    });
    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (e.key === "/" && !/INPUT|TEXTAREA|SELECT/.test(t.tagName) && !t.isContentEditable) {
        const local = document.querySelector<HTMLInputElement>("[data-local-search]");
        (local || document.getElementById("site-search") as HTMLInputElement)?.focus();
        e.preventDefault();
      }
    });
  </script>
</body>
</html>
