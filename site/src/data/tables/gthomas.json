 "entries": [
  {
   "n": 1,
   "form": "Hitah takoman?",
   "gloss": "Friend, from whence com'st?",
   "section": "The Indian Tongue | The English of it"
  },
  {
   "n": 2,
   "form": "Andogowa nee weekin.",
   "gloss": "Yonder. [Quest. Where yonder?] [Answ.] My House.",
   "section": "The Indian Tongue | The English of it"
  },
  {
   "n": 3,
   "form": "Tony andogowa kee weekin?",
   "gloss": "Where is thy House?",
   "section": "The Indian Tongue | The English of it"
  },
  {
   "n": 4,
   "form": "Arwaymouse.",
   "gloss": "Arwaymouse, which is the Name of an Indian Town.",
   "section": "The Indian Tongue | The English of it"
  },
  {
   "n": 5,
   "form": "Keco kee hatah kee weekin?",
   "gloss": "What hast got in thy House?",
   "section": "The Indian Tongue | The English of it"
  },
  {
   "n": 6,
   "form": "Nee hatah huska wees youse og huska chetena chase og huska orit chekenip.",
   "gloss": "I have very fat Venison, and good strong Skins, with very good Turkeys.",
   "section": "The Indian Tongue | The English of it"
  },
  {
   "n": 7,
   "form": "Chingo kee beto nee chase og youse etka chekenip.",
   "gloss": "When wilt thou bring me Skins and Venison, with Turkeys?",
   "section": "The Indian Tongue | The English of it"
  },
  {
   "n": 8,
   "form": "Halopa etka nisha kishquicka.",
   "gloss": "To morrow, or two days hence.",
   "section": "The Indian Tongue | The English of it"
  },
  {
   "n": 9,
   "form": "Keco kee hata kee weekin?",
   "gloss": "What hast got in thy House?",
   "section": "The Indian Tongue | The English of it"
  },
  {
   "n": 10,
   "form": "Nee hata orit poonk og huska horit haloons etka neskee og marchkee ochqueon.",
   "gloss": "I have very fat Venison, and good strong Skins, with very good Turkeys.",
   "section": "The Indian Tongue | The English of it",
   "note": {
    "kind": "print_error",
    "label": "Printing or translation slip",
    "text": "Indian text differs from row 6 (powder, bullets, black and red ...), yet the English repeats row 6 verbatim.",
    "compare": "Unami pùnk \"powder\", alunsh \"arrow, bullet\"; Pidgin neskee \"black\", marchkee \"red\"",
    "checked": false
   }
  },
  {
   "n": 11,
   "form": "(O huskia orit.)",
   "gloss": "(Very well.)",
   "section": "The Indian Tongue | The English of it",
   "concepts": [
    "WELL"
   ]
  },
  {
   "n": 12,
   "form": "Kee namen neskec kabay og marchkec moos etka opeg megis?",
   "gloss": "Did'st thou see black Horses and red Cows, with white Sheep?",
   "section": "The Indian Tongue | The English of it"
  },
  {
   "n": 13,
   "form": "Mata namen megis nee namen neskec kabay undogwa tekany.",
   "gloss": "I saw no Sheep: I did see black Horses yonder in the Woods?",
   "section": "The Indian Tongue | The English of it"
  },
  {
   "n": 14,
   "form": "Kee namen marchkec moos undogwa tekeny?",
   "gloss": "Did'st see red Cows yonder in the Woods?",
   "section": "The Indian Tongue | The English of it"
  },
  {
