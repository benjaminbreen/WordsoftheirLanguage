 "entries": [
  {
   "n": 1,
   "form": "Miris dilah, ingurah gotta",
   "gloss": "I have given Pepper, and got Ginger.",
   "section": "I shall conclude this Discourse of their Language, by giving you a tast of their Proverbs, some hints of the strain of their Speech."
  },
  {
   "n": 2,
   "form": "Datta horrala Badda peri•d",
   "gloss": "Pick your Teeth to fill your Belly.",
   "section": "I shall conclude this Discourse of their Language, by giving you a tast of their Proverbs, some hints of the strain of their Speech."
  },
  {
   "n": 3,
   "form": "Caula yonawa ruah atti",
   "gloss": "To eat before you go forth is handsom and convenient.",
   "section": "I shall conclude this Discourse of their Language, by giving you a tast of their Proverbs, some hints of the strain of their Speech."
  },
  {
   "n": 4,
   "form": "Kiallah tiannah, Degery illand avah oppala hanguand mordy",
   "gloss": "As the saying is, if I come to beg Butter-milk, why should I hide my Pan.",
   "section": "I shall conclude this Discourse of their Language, by giving you a tast of their Proverbs, some hints of the strain of their Speech."
  },
  {
   "n": 5,
   "form": "Hingonna wellendam cor cottonwat geah par wardenda netta",
   "gloss": "A Begger and a Trader cannot be lost.",
   "section": "I shall conclude this Discourse of their Language, by giving you a tast of their Proverbs, some hints of the strain of their Speech."
  },
  {
   "n": 6,
   "form": "Atting mitting delah hottarah harracurnowah",
   "gloss": "To lend to another makes him become an Enemy.",
   "section": "I shall conclude this Discourse of their Language, by giving you a tast of their Proverbs, some hints of the strain of their Speech."
  },
  {
   "n": 7,
   "form": "Annuna min yain ecka ourowaying younda eppa",
   "gloss": "Go not with a Slave in one Boat.",
   "section": "I shall conclude this Discourse of their Language, by giving you a tast of their Proverbs, some hints of the strain of their Speech."
  },
  {
   "n": 8,
   "form": "Issara otting bollanowa pos cotting",
   "gloss": "First look in the hand, afterwards open the mouth.",
   "section": "I shall conclude this Discourse of their Language, by giving you a tast of their Proverbs, some hints of the strain of their Speech."
  },
